{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Layer Sphere v0",
  "type": "object",
  "required": ["sphere_id", "owner", "evidence", "claims", "goals", "decisions", "outcomes", "corrections"],
  "properties": {
    "sphere_id": {"type": "string"},
    "owner": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string"},
        "display_name": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_type", "captured_at", "content"],
        "properties": {
          "id": {"type": "string"},
          "source_type": {"type": "string"},
          "source_uri": {"type": ["string", "null"]},
          "captured_at": {"type": "string"},
          "content": {},
          "visibility": {"enum": ["private", "public", "shared"]},
          "provenance": {"type": ["object", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "status", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "type": {"enum": ["fact", "self_assertion", "inference", "interpretation", "prediction", "uncertain"]},
          "status": {"enum": ["active", "superseded", "disputed", "archived"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "human_position": {"enum": ["confirmed", "disputed", "partially_true", "outdated", "unconfirmed"]},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"}
        }
      }
    },
    "goals": {"type": "array", "items": {"type": "object"}},
    "values": {"type": "array", "items": {"type": "object"}},
    "constraints": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "outcomes": {"type": "array", "items": {"type": "object"}},
    "corrections": {"type": "array", "items": {"type": "object"}},
    "permissions": {"type": "array", "items": {"type": "object"}}
  }
}